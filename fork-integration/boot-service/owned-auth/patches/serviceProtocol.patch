+// Node-only: serviceLauncher must survive an unloadable child Effect graph.
+export interface OwnedServiceBinding {
+  readonly profile: "blackcrab-local-service-layout-v1";
+  readonly generation: number;
+  readonly manifestSha256: string;
+  readonly environmentId: string;
+}
+export function validOwnedServiceBinding(value: unknown): value is OwnedServiceBinding {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const x = value as Record<string, unknown>;
+  return Object.keys(x).sort().join(",") === "environmentId,generation,manifestSha256,profile" &&
+    x.profile === "blackcrab-local-service-layout-v1" && Number.isSafeInteger(x.generation) &&
+    (x.generation as number) > 0 && typeof x.manifestSha256 === "string" && /^[a-f0-9]{64}$/.test(x.manifestSha256) &&
+    typeof x.environmentId === "string" && x.environmentId.trim() === x.environmentId &&
+    x.environmentId.length > 0 && x.environmentId.length <= 128 && !/[\x00-\x1f\x7f]/.test(x.environmentId);
+}
 

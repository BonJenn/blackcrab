{
  "name": "blackcrab",
  "private": true,
  "version": "0.4.3",
  "description": "A desktop workspace for coding agents, projects and remote access.",
  "author": "Jonathan Benn",
  "license": "Apache-2.0",
  "homepage": "https://github.com/BonJenn/blackcrab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BonJenn/blackcrab.git"
  },
  "bugs": {
    "url": "https://github.com/BonJenn/blackcrab/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/t3-mobile/packages/*"
  ],
  "overrides": {
    "expo": "58.0.14",
    "react-native": "0.88.0",
    "@react-navigation/native-stack": {
      ".": "7.21.0",
      "react-native-screens": "5.0.0-t3.48"
    },
    "react-native-image-viewing": "0.2.2",
    "mdast-util-math": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "micromark-extension-gfm-table": "2.1.1",
    "micromark": "4.0.2",
    "mdast-util-to-hast": "13.2.1",
    "expo-audio": "58.0.9",
    "expo-video": "58.0.11",
    "expo-network": "58.0.3",
    "@clerk/expo-native-components": "0.4.0",
    "@expo/metro-config": "58.0.14",
    "expo-sharing": "58.0.19",
    "expo-widgets": "58.0.20",
    "@legendapp/list": "3.3.5",
    "@pierre/diffs": "1.6.1",
    "@react-native-ai/apple": "0.12.0",
    "@react-native-menu/menu": "2.0.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-pdf-jsi": "5.0.0",
    "react-native-webview": "14.0.1",
    "@expo/ui": "58.0.20",
    "expo-modules-core": "58.0.22",
    "@expo/fingerprint": "0.21.5",
    "remark-math": {
      "micromark-extension-math": "npm:micromark-extension-llm-math@3.1.0"
    },
    "@react-navigation/core": "7.24.0",
    "expo-modules-jsi": "58.0.15",
    "micromark-util-types": "2.0.2"
  },
  "scripts": {
    "dev": "node scripts/tauri-dev.mjs",
    "dev:desktop": "node scripts/tauri-dev.mjs",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:native": "node scripts/tauri-build.mjs --local",
    "build:native:signed": "node scripts/tauri-build.mjs --signed",
    "check": "npm run typecheck && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "smoke": "node scripts/smoke-check.mjs",
    "smoke:native": "node scripts/smoke-check.mjs --native",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:managed-host": "node scripts/build-managed-host.mjs",
    "verify:managed-host": "node scripts/verify-managed-host.mjs",
    "smoke:managed-host": "node scripts/smoke-managed-host.mjs",
    "test:managed-host": "node --test managed-host/*.test.mjs",
    "build:shared-runtime": "node scripts/build-shared-runtime.mjs",
    "test:shared-runtime": "node --test shared-runtime/*.test.mjs",
    "verify:shared-runtime": "node scripts/verify-shared-runtime.mjs vendor/t3",
    "bundle:shared-runtime:ios": "node scripts/bundle-shared-runtime-ios.mjs",
    "prepare:mobile:ios": "node scripts/prepare-mobile-ios.mjs",
    "test:mobile:ios-preparation": "node --test scripts/prepare-mobile-ios.test.mjs apps/mobile/plugins/with-ios-pod-floor.test.cjs",
    "test:mobile:experience": "node --test mobile-experience/*.test.mjs",
    "test:managed-acceptance": "vitest run --config managed-validation/vitest.config.ts",
    "typecheck:managed-acceptance": "tsc --project managed-validation/tsconfig.json",
    "postinstall": "node mobile-experience/apply-installed.mjs",
    "verify:mobile:consumers": "node mobile-experience/verify-consumers-cli.mjs vendor/t3-mobile",
    "prepare:mobile:resources": "node mobile-experience/resources-cli.mjs",
    "test:mobile:resolution": "node --test apps/mobile/metro-resolution.test.cjs",
    "test:mobile:catalog": "node mobile-experience/resources-cli.mjs --ui-only && vitest run --config managed-validation/native-mobile-policy.vitest.config.ts",
    "test:mobile:updates": "node mobile-experience/resources-cli.mjs --ui-only && vitest run --config managed-validation/mobile-updates.vitest.config.ts",
    "check:tauri-versions": "node scripts/check-tauri-versions.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.6",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "yaml": "2.9.0",
    "tailwindcss": "4.3.3",
    "@blackcrab/mobile-stream-builder": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "micromark-util-types": "2.0.2",
    "@types/ws": "8.18.2",
    "ws": "8.22.1"
  },
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "26.12.1"
  },
  "allowScripts": {
    "file:vendor/t3-mobile/apps/mobile/deps/react-native-enriched-markdown-1.2.0-t3.16-29ddd424.tgz": true
  }
}

{
  "expo": {
    "name": "Blackcrab Remote",
    "slug": "blackcrab-remote",
    "scheme": "blackcrab-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.blackcrab.remote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Blackcrab Remote connects to your desktop on the same Wi-Fi to control Claude Code sessions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.blackcrab.remote",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Blackcrab Remote uses the camera to scan pairing QR codes from your desktop."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Blackcrab Remote needs photo access to attach images to a message.",
          "cameraPermission": "Blackcrab Remote needs camera access to take a photo to attach to a message."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "33fb14fd-4b87-4e85-920c-b6d4204e4567"
      }
    },
    "owner": "bonjenn",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/33fb14fd-4b87-4e85-920c-b6d4204e4567"
    }
  }
}

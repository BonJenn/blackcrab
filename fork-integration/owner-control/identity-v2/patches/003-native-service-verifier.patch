 fn bootstrap_token(secret: &str, now: u64) -> Result<String, String> {
     let mut mac = Hmac::<Sha256>::new_from_slice(secret.as_bytes()).map_err(io_error)?;
     mac.update(format!("t3-desktop-bootstrap:{}", now / 43_200_000).as_bytes());

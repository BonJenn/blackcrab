{
  "expo": {
    "name": "Blackcrab Remote",
    "slug": "blackcrab-remote",
    "scheme": "blackcrab-remote",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.blackcrab.remote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Blackcrab Remote connects to your desktop on the same Wi-Fi to control Claude Code sessions."
      }
    },
    "android": {
      "package": "dev.blackcrab.remote"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Blackcrab Remote uses the camera to scan pairing QR codes from your desktop."
        }
      ]
    ]
  }
}

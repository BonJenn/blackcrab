+it("persists paired selection per composer through clear and hydration without changing lead settings", () => {
+  resetComposerDraftStore();
+  const first = scopeThreadRef(TEST_ENVIRONMENT_ID, ThreadId.make("paired-first"));
+  const second = scopeThreadRef(TEST_ENVIRONMENT_ID, ThreadId.make("paired-second"));
+  const partner = {
+    instanceId: CLAUDE_AGENT_INSTANCE,
+    model: "peer",
+    options: [{ id: "effort", value: "high" }],
+  };
+  const store = useComposerDraftStore.getState();
+  store.setPairedModel(first, partner);
+  store.clearComposerContent(first);
+  expect(useComposerDraftStore.getState().getComposerDraft(first)?.pairedModel).toEqual(partner);
+  expect(useComposerDraftStore.getState().getComposerDraft(second)?.pairedModel).toBeUndefined();
+  const state = useComposerDraftStore.getState();
+  const persisted = partializeComposerDraftStoreState(state);
+  const restored = useComposerDraftStore.persist.getOptions().merge!(
+    persisted,
+    useComposerDraftStore.getInitialState(),
+  );
+  useComposerDraftStore.setState(restored);
+  expect(useComposerDraftStore.getState().getComposerDraft(first)?.pairedModel).toEqual(partner);
+  expect(useComposerDraftStore.getState().getComposerDraft(first)?.activeProvider).toBeNull();
+  useComposerDraftStore.getState().setPairedModel(first, undefined);
+  expect(useComposerDraftStore.getState().getComposerDraft(first)?.pairedModel).toBeUndefined();
+});

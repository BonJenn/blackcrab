+describe("Blackcrab update notification", () => {
+  it("announces a Blackcrab update once per version without installing it", async () => {
+    const toast = vi.spyOn(toastManager, "add").mockReturnValue("update-notice");
+    try {
+      const available = { ...nightlyUpdate([]), channel: "latest" as const, availableVersion: "0.4.5" };
+      setup(available);
+      await using _screen = await render(<SidebarUpdatePill />);
+      expect(toast).toHaveBeenCalledWith(expect.objectContaining({title: "Blackcrab 0.4.5 is available"}));
+      await publish({ ...available });
+      await publish({ ...available, status: "checking" });
+      await publish({ ...available });
+      expect(toast).toHaveBeenCalledTimes(1);
+      await publish({ ...available, availableVersion: "0.4.6" });
+      expect(toast).toHaveBeenCalledTimes(2);
+      expect(toast).toHaveBeenLastCalledWith(expect.objectContaining({title: "Blackcrab 0.4.6 is available"}));
+    } finally { toast.mockRestore(); }
+  });
+});

{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "26.12.1"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "node": "26.12.1",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "node": "26.12.1",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

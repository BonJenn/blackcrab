import {it,expect} from 'vite-plus/test';
import * as Effect from 'effect/Effect';
import * as Scope from 'effect/Scope';
import * as Exit from 'effect/Exit';
import * as NodeServices from '@effect/platform-node/NodeServices';
import {EnvironmentId,DesktopBrowserCommand} from '@t3tools/contracts';
import * as Schema from 'effect/Schema';
import * as fs from 'node:fs/promises';
import {once} from 'node:events';
import {makeSocketChannel} from './SocketDesktopBrowserChannel.ts';
import * as Environment from '../environment/ServerEnvironment.ts';
import {connectBrowser,type Payload} from '../../../../packages/shared/src/leasedDesktopBrowser.ts';
const key={threadId:'thread-1',tabId:'tab-1'};
const wait=async(test:()=>boolean)=>{for(let i=0;i<200;i++){if(test())return;await new Promise(r=>setTimeout(r,5));}throw Error('bounded condition failed');};
it('old actual endpoint Scope release cannot release a reconnected same-key native tab',async()=>{
 const root=await fs.realpath(await fs.mkdtemp('/tmp/bc-c-'));await fs.chmod(root,0o700);
 const config={path:root+'/b.sock',key:'6'.repeat(64),environmentId:'env-test',generation:1};
 const received:Payload[]=[];const peers:ReturnType<typeof connectBrowser>[]=[];
 try{await Effect.runPromise(Effect.scoped(Effect.gen(function*(){
  const channel=yield* makeSocketChannel(config);
  const connect=async()=>{let ready=false;const p=connectBrowser(config,{validateCommand:Schema.is(DesktopBrowserCommand),ready:()=>{ready=true},command:p=>received.push(p),retired:()=>{}});peers.push(p);await wait(()=>ready);await p.send({type:'attached',...key});await wait(()=>Boolean(channel.identity!(key)));return p;};
  const first=yield* Effect.promise(connect);const old=channel.identity!(key)!;
  const oldScope=yield* Scope.make();const endpoint=yield* channel.endpoint({...key,attachment:old}).pipe(Scope.provide(oldScope));
  const websocket=new WebSocket(endpoint);yield* Effect.promise(()=>once(websocket,'open'));websocket.send(JSON.stringify({id:1,method:'Browser.getVersion'}));yield* Effect.promise(()=>wait(()=>received.some(p=>p.type==='cdp')));websocket.close();
  const sameLeaseScope=yield* Scope.make();yield* channel.endpoint({...key,attachment:old}).pipe(Scope.provide(sameLeaseScope));yield* Scope.close(oldScope,Exit.void);expect(received.filter(p=>p.type==='release')).toEqual([]);
  first.close();yield* Effect.promise(()=>wait(()=>!channel.identity!(key)));
  yield* Effect.promise(connect);const successor=channel.identity!(key)!;expect(successor.peerEpoch).not.toBe(old.peerEpoch);
  yield* Scope.close(sameLeaseScope,Exit.void);
  yield* channel.pointer({...key,attachment:successor},{phase:'move',x:3,y:4});
  yield* Effect.promise(()=>wait(()=>received.some(p=>p.type==='pointer')));
  expect(received.filter(p=>p.type==='release')).toEqual([]);
  expect(channel.isCurrent!(successor)).toBe(true);
 })).pipe(Effect.provideService(Environment.ServerEnvironment,{getEnvironmentId:Effect.succeed(EnvironmentId.make(config.environmentId)),getDescriptor:Effect.die('unused')}),Effect.provide(NodeServices.layer)));
 }finally{peers.forEach(p=>p.close());await fs.rm(root,{recursive:true,force:true});}
},15000);
